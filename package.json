{
  "name": "devtools",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm core:build && (pnpm --filter @fadeltd/devtools-core dev & vite)",
    "build": "pnpm core:build && vite build && pnpm seo",
    "preview": "vite preview",
    "typecheck": "pnpm core:build && tsc --noEmit && pnpm --filter @fadeltd/devtools-core typecheck",
    "test": "vitest run && pnpm --filter @fadeltd/devtools-core test",
    "test:watch": "vitest",
    "lint": "oxlint",
    "deploy": "pnpm build && wrangler deploy",
    "seo": "vite-node scripts/seo.ts",
    "tw:fix": "vite-node scripts/tw-fix.ts",
    "core:build": "pnpm --filter @fadeltd/devtools-core build"
  },
  "dependencies": {
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@fadeltd/devtools-core": "workspace:*",
    "@tanstack/react-virtual": "3.14.12",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "codemirror": "6.0.2",
    "comlink": "4.4.2",
    "dompurify": "3.4.17",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.47.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sql-formatter": "15.9.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.10.2",
    "oxlint": "1.85.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.1",
    "wrangler": "4.136.1"
  },
  "license": "MIT",
  "description": "Client-only developer utilities. Nothing you paste leaves the browser.",
  "repository": {
    "type": "git",
    "url": "https://github.com/fadeltd/devtools.git"
  },
  "homepage": "https://devtools.fadeltd.dev"
}
